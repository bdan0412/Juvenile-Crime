                <component
                  refId="Package\SC02_LOAD_DIMENSIONS_NO_REFERENCE\DF12_LOAD_TIME\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH H AS
(
    SELECT TOP (24)
        ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS hour_num
    FROM sys.all_objects
)
SELECT
    CAST(hour_num AS TINYINT) AS hour_num,

    CAST(
        CASE
            WHEN hour_num BETWEEN 0 AND 5 THEN 'Night'
            WHEN hour_num BETWEEN 6 AND 11 THEN 'Morning'
            WHEN hour_num BETWEEN 12 AND 17 THEN 'Afternoon'
            ELSE 'Evening'
        END
        AS VARCHAR(20)
    ) AS time_period,

    CAST(
        CASE
            WHEN hour_num BETWEEN 0 AND 5 THEN 1
            WHEN hour_num BETWEEN 6 AND 11 THEN 2
            WHEN hour_num BETWEEN 12 AND 17 THEN 3
            ELSE 4
        END
        AS TINYINT
    ) AS period_order

FROM H;</property>
