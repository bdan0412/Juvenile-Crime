                <component
                  refId="Package\SC02_LOAD_DIMENSIONS_NO_REFERENCE\DF11_LOAD_DATE\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH N AS
(
    SELECT TOP (1826)
        ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n
    FROM sys.all_objects a
    CROSS JOIN sys.all_objects b
),
D AS
(
    SELECT
        CAST(
            DATEADD(DAY, n, CAST('2021-01-01' AS DATE))
            AS DATE
        ) AS full_date
    FROM N
)

SELECT
    /* DATE */
    CAST(full_date AS DATE) AS full_date,

    /* YEAR */
    CAST(YEAR(full_date) AS SMALLINT) AS year_num,

    /* QUARTER */
    CAST(DATEPART(QUARTER, full_date) AS TINYINT) AS quarter_num,

    CAST(
        CAST(YEAR(full_date) AS VARCHAR(4))
        + '-Q'
        + CAST(DATEPART(QUARTER, full_date) AS VARCHAR(1))
        AS VARCHAR(7)
    ) AS year_quarter_key,

    /* MONTH */
    CAST(MONTH(full_date) AS TINYINT) AS month_num,

    CAST(
        CASE MONTH(full_date)
            WHEN 1 THEN 'January'
            WHEN 2 THEN 'February'
            WHEN 3 THEN 'March'
            WHEN 4 THEN 'April'
            WHEN 5 THEN 'May'
            WHEN 6 THEN 'June'
            WHEN 7 THEN 'July'
            WHEN 8 THEN 'August'
            WHEN 9 THEN 'September'
            WHEN 10 THEN 'October'
            WHEN 11 THEN 'November'
            WHEN 12 THEN 'December'
        END
        AS VARCHAR(20)
    ) AS month_name,

    CAST(
        CAST(YEAR(full_date) AS VARCHAR(4))
        + '-'
        + RIGHT(
            '0' + CAST(MONTH(full_date) AS VARCHAR(2)),
            2
        )
        AS VARCHAR(7)
    ) AS year_month_key,

    /* DAY */
    CAST(DAY(full_date) AS TINYINT) AS day_num,

    /* Sunday = 1 ... Saturday = 7 */
    CAST(
        ((DATEDIFF(DAY, '19000107', full_date) % 7 + 7) % 7) + 1
        AS TINYINT
    ) AS day_of_week_num,

    CAST(
        CASE
            WHEN ((DATEDIFF(DAY, '19000107', full_date) % 7 + 7) % 7) + 1 = 1
                THEN 'Sunday'
            WHEN ((DATEDIFF(DAY, '19000107', full_date) % 7 + 7) % 7) + 1 = 2
                THEN 'Monday'
            WHEN ((DATEDIFF(DAY, '19000107', full_date) % 7 + 7) % 7) + 1 = 3
                THEN 'Tuesday'
            WHEN ((DATEDIFF(DAY, '19000107', full_date) % 7 + 7) % 7) + 1 = 4
                THEN 'Wednesday'
            WHEN ((DATEDIFF(DAY, '19000107', full_date) % 7 + 7) % 7) + 1 = 5
                THEN 'Thursday'
            WHEN ((DATEDIFF(DAY, '19000107', full_date) % 7 + 7) % 7) + 1 = 6
                THEN 'Friday'
            ELSE 'Saturday'
        END
        AS VARCHAR(20)
    ) AS day_name,

    CAST(
        CASE
            WHEN
                ((DATEDIFF(DAY, '19000107', full_date) % 7 + 7) % 7) + 1
                IN (1, 7)
            THEN 1
            ELSE 0
        END
        AS BIT
    ) AS is_weekend

FROM D
WHERE full_date &lt;= CAST('2025-12-31' AS DATE);</property>
