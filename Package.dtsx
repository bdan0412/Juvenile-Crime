                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH A AS
(
    SELECT
        agency_id,
        MAX(ori) AS ori,
        MAX(pub_agency_name) AS agency_name,
        MAX(agency_type_name) AS agency_type_name,
        MAX(county_name) AS county_name

    FROM dbo.STG_Agency
    GROUP BY agency_id
),
Missing AS
(
    SELECT DISTINCT
        i.agency_id

    FROM dbo.STG_Incident i

    LEFT JOIN A
        ON i.agency_id = A.agency_id

    WHERE A.agency_id IS NULL
)

SELECT
    CAST(agency_id AS BIGINT) AS agency_id,
    CAST(ori AS VARCHAR(10)) AS ori,
    CAST(agency_name AS VARCHAR(100)) AS agency_name,
    CAST(agency_type_name AS VARCHAR(50)) AS agency_type_name,
    CAST(county_name AS VARCHAR(50)) AS county_name

FROM A

UNION ALL

SELECT
    CAST(agency_id AS BIGINT),
    CAST(NULL AS VARCHAR(10)),
    CAST('Unknown Agency' AS VARCHAR(100)),
    CAST('Unknown' AS VARCHAR(50)),
    CAST('Unknown' AS VARCHAR(50))

FROM Missing;</property>
