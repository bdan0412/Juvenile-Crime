    <DTS:Executable
      DTS:refId="Package\SC00_INIT_WAREHOUSE"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{8BB528CF-4CA3-4CE3-868C-6905CC3F6A46}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="SC00_INIT_WAREHOUSE">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\SC00_INIT_WAREHOUSE\SQL01_DROP_ALL_TABLES"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{AA4E330D-3309-4BE4-A1FA-5258FEB5974C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL01_DROP_ALL_TABLES"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0129F2FC-FF53-4CE6-AA1E-5C83E1D76E0B}"
              SQLTask:SqlStatementSource="/* =========================================================&#xA;   DROP BRIDGE&#xA;========================================================= */&#xA;&#xA;DROP TABLE IF EXISTS dbo.Bridge_ArresteeWeapon;&#xA;DROP TABLE IF EXISTS dbo.Bridge_IncidentVictim;&#xA;DROP TABLE IF EXISTS dbo.Bridge_IncidentOffender;&#xA;DROP TABLE IF EXISTS dbo.Bridge_IncidentArrestee;&#xA;DROP TABLE IF EXISTS dbo.Bridge_IncidentOffense;&#xA;&#xA;&#xA;/* =========================================================&#xA;   DROP FACT&#xA;========================================================= */&#xA;&#xA;DROP TABLE IF EXISTS dbo.Fact_JuvenileIncident;&#xA;&#xA;&#xA;/* =========================================================&#xA;   DROP DIMENSIONS&#xA;========================================================= */&#xA;&#xA;DROP TABLE IF EXISTS dbo.Dim_Weapon;&#xA;DROP TABLE IF EXISTS dbo.Dim_Victim;&#xA;DROP TABLE IF EXISTS dbo.Dim_Arrestee;&#xA;&#xA;DROP TABLE IF EXISTS dbo.Dim_Offense;&#xA;DROP TABLE IF EXISTS dbo.Dim_Agency;&#xA;DROP TABLE IF EXISTS dbo.Dim_Race;&#xA;DROP TABLE IF EXISTS dbo.Dim_Sex;&#xA;DROP TABLE IF EXISTS dbo.Dim_Age;&#xA;&#xA;DROP TABLE IF EXISTS dbo.Dim_Time;&#xA;DROP TABLE IF EXISTS dbo.Dim_Date;&#xA;&#xA;&#xA;/* =========================================================&#xA;   DROP STAGING&#xA;========================================================= */&#xA;&#xA;DROP TABLE IF EXISTS dbo.STG_ArresteeWeapon;&#xA;DROP TABLE IF EXISTS dbo.STG_Victim;&#xA;DROP TABLE IF EXISTS dbo.STG_Arrestee;&#xA;&#xA;DROP TABLE IF EXISTS dbo.STG_Offense;&#xA;DROP TABLE IF EXISTS dbo.STG_Incident;&#xA;&#xA;DROP TABLE IF EXISTS dbo.STG_WeaponType;&#xA;DROP TABLE IF EXISTS dbo.STG_OffenseType;&#xA;DROP TABLE IF EXISTS dbo.STG_Agency;&#xA;DROP TABLE IF EXISTS dbo.STG_Race;&#xA;DROP TABLE IF EXISTS dbo.STG_Age;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\SC00_INIT_WAREHOUSE\SQL02_CREATE_STAGING"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{002EFF16-D253-4CC9-9368-02AF6970BAD6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL02_CREATE_STAGING"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0129F2FC-FF53-4CE6-AA1E-5C83E1D76E0B}"
              SQLTask:SqlStatementSource="/* =========================================================&#xA;   REFERENCE STAGING&#xA;========================================================= */&#xA;&#xA;CREATE TABLE dbo.STG_Age&#xA;(&#xA;    age_id      INT           NOT NULL,&#xA;    age_code    VARCHAR(2)    NOT NULL,&#xA;    age_name    VARCHAR(30)   NOT NULL,&#xA;&#xA;    CONSTRAINT PK_STG_Age&#xA;        PRIMARY KEY (age_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.STG_Race&#xA;(&#xA;    race_id      INT           NOT NULL,&#xA;    race_code    VARCHAR(2)    NOT NULL,&#xA;    race_desc    VARCHAR(60)   NOT NULL,&#xA;&#xA;    CONSTRAINT PK_STG_Race&#xA;        PRIMARY KEY (race_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.STG_OffenseType&#xA;(&#xA;    offense_code           VARCHAR(3)     NOT NULL,&#xA;    offense_name           VARCHAR(100)   NOT NULL,&#xA;    offense_category_name  VARCHAR(100)   NOT NULL,&#xA;    crime_against          VARCHAR(30)    NOT NULL,&#xA;&#xA;    CONSTRAINT PK_STG_OffenseType&#xA;        PRIMARY KEY (offense_code)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.STG_WeaponType&#xA;(&#xA;    data_year    SMALLINT       NOT NULL,&#xA;    weapon_id    INT            NOT NULL,&#xA;    weapon_name  VARCHAR(60)    NOT NULL,&#xA;    weapon_code  INT            NOT NULL,&#xA;&#xA;    CONSTRAINT PK_STG_WeaponType&#xA;        PRIMARY KEY (data_year, weapon_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.STG_Agency&#xA;(&#xA;    data_year           SMALLINT       NOT NULL,&#xA;    agency_id           BIGINT         NOT NULL,&#xA;    ori                 VARCHAR(10)    NOT NULL,&#xA;    pub_agency_name     VARCHAR(100)   NOT NULL,&#xA;    agency_type_name    VARCHAR(50)    NOT NULL,&#xA;    population          INT            NOT NULL,&#xA;    county_name         VARCHAR(50)    NOT NULL,&#xA;    msa_name            VARCHAR(100)   NOT NULL,&#xA;    nibrs_participated  VARCHAR(1)     NOT NULL,&#xA;&#xA;    CONSTRAINT PK_STG_Agency&#xA;        PRIMARY KEY (data_year, agency_id)&#xA;);&#xA;&#xA;&#xA;/* =========================================================&#xA;   TRANSACTION STAGING&#xA;========================================================= */&#xA;&#xA;CREATE TABLE dbo.STG_Incident&#xA;(&#xA;    data_year       SMALLINT   NOT NULL,&#xA;    incident_id     BIGINT     NOT NULL,&#xA;    agency_id       BIGINT     NOT NULL,&#xA;    incident_date   DATE       NOT NULL,&#xA;    incident_hour   TINYINT    NULL,&#xA;&#xA;    CONSTRAINT PK_STG_Incident&#xA;        PRIMARY KEY (incident_id),&#xA;&#xA;    CONSTRAINT CK_STG_Incident_Hour&#xA;        CHECK&#xA;        (&#xA;            incident_hour BETWEEN 0 AND 23&#xA;            OR incident_hour IS NULL&#xA;        )&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.STG_Offense&#xA;(&#xA;    data_year       SMALLINT      NOT NULL,&#xA;    offense_id      BIGINT        NOT NULL,&#xA;    incident_id     BIGINT        NOT NULL,&#xA;    offense_code    VARCHAR(3)    NOT NULL,&#xA;&#xA;    CONSTRAINT PK_STG_Offense&#xA;        PRIMARY KEY (offense_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.STG_Arrestee&#xA;(&#xA;    data_year      SMALLINT      NOT NULL,&#xA;    arrestee_id    BIGINT        NOT NULL,&#xA;    incident_id    BIGINT        NOT NULL,&#xA;    arrest_date    DATE          NOT NULL,&#xA;    offense_code   VARCHAR(3)    NOT NULL,&#xA;    age_id         INT           NOT NULL,&#xA;    sex_code       VARCHAR(1)    NOT NULL,&#xA;    race_id        INT           NOT NULL,&#xA;&#xA;    CONSTRAINT PK_STG_Arrestee&#xA;        PRIMARY KEY (arrestee_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.STG_Victim&#xA;(&#xA;    data_year      SMALLINT      NOT NULL,&#xA;    victim_id      BIGINT        NOT NULL,&#xA;    incident_id    BIGINT        NOT NULL,&#xA;    age_id         INT           NOT NULL,&#xA;    sex_code       VARCHAR(1)    NOT NULL,&#xA;    race_id        INT           NOT NULL,&#xA;&#xA;    CONSTRAINT PK_STG_Victim&#xA;        PRIMARY KEY (victim_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.STG_ArresteeWeapon&#xA;(&#xA;    data_year     SMALLINT    NOT NULL,&#xA;    arrestee_id   BIGINT      NOT NULL,&#xA;    weapon_id     INT         NOT NULL,&#xA;&#xA;    CONSTRAINT PK_STG_ArresteeWeapon&#xA;        PRIMARY KEY&#xA;        (&#xA;            data_year,&#xA;            arrestee_id,&#xA;            weapon_id&#xA;        )&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\SC00_INIT_WAREHOUSE\SQL03_INIT_WAREHOUSE"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{FA99133A-EBAA-404C-9877-07425429C819}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL03_INIT_WAREHOUSE"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0129F2FC-FF53-4CE6-AA1E-5C83E1D76E0B}"
              SQLTask:SqlStatementSource="/* =========================================================&#xA;   DIMENSIONS KHÔNG PHỤ THUỘC DIMENSION KHÁC&#xA;========================================================= */&#xA;&#xA;CREATE TABLE dbo.Dim_Date&#xA;(&#xA;    full_date           DATE          NOT NULL,&#xA;    year_num            SMALLINT      NOT NULL,&#xA;    quarter_num         TINYINT       NOT NULL,&#xA;    year_quarter_key    VARCHAR(7)    NOT NULL,&#xA;&#xA;    month_num           TINYINT       NOT NULL,&#xA;    month_name          VARCHAR(20)   NOT NULL,&#xA;    year_month_key      VARCHAR(7)    NOT NULL,&#xA;&#xA;    day_num             TINYINT       NOT NULL,&#xA;    day_of_week_num     TINYINT       NOT NULL,&#xA;    day_name            VARCHAR(20)   NOT NULL,&#xA;&#xA;    is_weekend          BIT           NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Dim_Date&#xA;        PRIMARY KEY (full_date)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.Dim_Time&#xA;(&#xA;    hour_num        TINYINT       NOT NULL,&#xA;    time_period     VARCHAR(20)   NOT NULL,&#xA;    period_order    TINYINT       NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Dim_Time&#xA;        PRIMARY KEY (hour_num)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.Dim_Sex&#xA;(&#xA;    sex_code      VARCHAR(1)    NOT NULL,&#xA;    sex_name      VARCHAR(30)   NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Dim_Sex&#xA;        PRIMARY KEY (sex_code)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.Dim_Age&#xA;(&#xA;    age_id            INT            NOT NULL,&#xA;    age_code          VARCHAR(2)     NOT NULL,&#xA;    age_name          VARCHAR(30)    NOT NULL,&#xA;&#xA;    age_group         VARCHAR(20)    NOT NULL,&#xA;    age_group_order   TINYINT        NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Dim_Age&#xA;        PRIMARY KEY (age_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.Dim_Race&#xA;(&#xA;    race_id       INT            NOT NULL,&#xA;    race_code     VARCHAR(2)     NOT NULL,&#xA;    race_desc     VARCHAR(60)    NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Dim_Race&#xA;        PRIMARY KEY (race_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.Dim_Agency&#xA;(&#xA;    agency_id           BIGINT         NOT NULL,&#xA;    ori                 VARCHAR(10)    NULL,&#xA;    agency_name         VARCHAR(100)   NOT NULL,&#xA;    agency_type_name    VARCHAR(50)    NULL,&#xA;    county_name         VARCHAR(50)    NULL,&#xA;&#xA;    CONSTRAINT PK_Dim_Agency&#xA;        PRIMARY KEY (agency_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.Dim_Offense&#xA;(&#xA;    offense_code           VARCHAR(3)     NOT NULL,&#xA;    offense_name           VARCHAR(100)   NOT NULL,&#xA;    offense_category_name  VARCHAR(100)   NOT NULL,&#xA;    crime_against          VARCHAR(20)    NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Dim_Offense&#xA;        PRIMARY KEY (offense_code)&#xA;);&#xA;&#xA;&#xA;/*&#xA;    weapon_id KHÔNG ổn định qua các năm.&#xA;    weapon_name mới là tên loại vũ khí ổn định cho OLAP.&#xA;*/&#xA;CREATE TABLE dbo.Dim_Weapon&#xA;(&#xA;    weapon_name     VARCHAR(60)    NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Dim_Weapon&#xA;        PRIMARY KEY (weapon_name)&#xA;);&#xA;&#xA;&#xA;/* =========================================================&#xA;   DIMENSIONS CÓ REFERENCE&#xA;========================================================= */&#xA;&#xA;CREATE TABLE dbo.Dim_Arrestee&#xA;(&#xA;    arrestee_id     BIGINT        NOT NULL,&#xA;    data_year       SMALLINT      NOT NULL,&#xA;    arrest_date     DATE          NOT NULL,&#xA;&#xA;    offense_code    VARCHAR(3)    NOT NULL,&#xA;    age_id          INT           NOT NULL,&#xA;    sex_code        VARCHAR(1)    NOT NULL,&#xA;    race_id         INT           NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Dim_Arrestee&#xA;        PRIMARY KEY (arrestee_id),&#xA;&#xA;    CONSTRAINT FK_Arrestee_Offense&#xA;        FOREIGN KEY (offense_code)&#xA;        REFERENCES dbo.Dim_Offense(offense_code),&#xA;&#xA;    CONSTRAINT FK_Arrestee_Age&#xA;        FOREIGN KEY (age_id)&#xA;        REFERENCES dbo.Dim_Age(age_id),&#xA;&#xA;    CONSTRAINT FK_Arrestee_Sex&#xA;        FOREIGN KEY (sex_code)&#xA;        REFERENCES dbo.Dim_Sex(sex_code),&#xA;&#xA;    CONSTRAINT FK_Arrestee_Race&#xA;        FOREIGN KEY (race_id)&#xA;        REFERENCES dbo.Dim_Race(race_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.Dim_Victim&#xA;(&#xA;    victim_id      BIGINT        NOT NULL,&#xA;    data_year      SMALLINT      NOT NULL,&#xA;&#xA;    age_id         INT           NOT NULL,&#xA;    sex_code       VARCHAR(1)    NOT NULL,&#xA;    race_id        INT           NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Dim_Victim&#xA;        PRIMARY KEY (victim_id),&#xA;&#xA;    CONSTRAINT FK_Victim_Age&#xA;        FOREIGN KEY (age_id)&#xA;        REFERENCES dbo.Dim_Age(age_id),&#xA;&#xA;    CONSTRAINT FK_Victim_Sex&#xA;        FOREIGN KEY (sex_code)&#xA;        REFERENCES dbo.Dim_Sex(sex_code),&#xA;&#xA;    CONSTRAINT FK_Victim_Race&#xA;        FOREIGN KEY (race_id)&#xA;        REFERENCES dbo.Dim_Race(race_id)&#xA;);&#xA;&#xA;&#xA;/* =========================================================&#xA;   FACT&#xA;========================================================= */&#xA;&#xA;CREATE TABLE dbo.Fact_JuvenileIncident&#xA;(&#xA;    incident_id        BIGINT      NOT NULL,&#xA;&#xA;    data_year          SMALLINT    NOT NULL,&#xA;    incident_date      DATE        NOT NULL,&#xA;    incident_hour      TINYINT     NULL,&#xA;&#xA;    agency_id          BIGINT      NOT NULL,&#xA;&#xA;    incident_count     INT         NOT NULL DEFAULT 1,&#xA;&#xA;    offense_cnt        INT         NOT NULL DEFAULT 0,&#xA;    arrestee_cnt       INT         NOT NULL DEFAULT 0,&#xA;    victim_cnt         INT         NOT NULL DEFAULT 0,&#xA;&#xA;    has_weapon_flag    BIT         NOT NULL DEFAULT 0,&#xA;&#xA;    high_risk_flag AS&#xA;    (&#xA;        CASE&#xA;            WHEN arrestee_cnt &gt; 1&#xA;             AND has_weapon_flag = 1&#xA;             AND victim_cnt &gt;= 1&#xA;            THEN CONVERT(BIT, 1)&#xA;            ELSE CONVERT(BIT, 0)&#xA;        END&#xA;    ) PERSISTED,&#xA;&#xA;    CONSTRAINT PK_Fact_JuvenileIncident&#xA;        PRIMARY KEY (incident_id),&#xA;&#xA;    CONSTRAINT FK_Fact_Date&#xA;        FOREIGN KEY (incident_date)&#xA;        REFERENCES dbo.Dim_Date(full_date),&#xA;&#xA;    CONSTRAINT FK_Fact_Time&#xA;        FOREIGN KEY (incident_hour)&#xA;        REFERENCES dbo.Dim_Time(hour_num),&#xA;&#xA;    CONSTRAINT FK_Fact_Agency&#xA;        FOREIGN KEY (agency_id)&#xA;        REFERENCES dbo.Dim_Agency(agency_id)&#xA;);&#xA;&#xA;&#xA;/* =========================================================&#xA;   BRIDGES&#xA;========================================================= */&#xA;&#xA;CREATE TABLE dbo.Bridge_IncidentOffense&#xA;(&#xA;    incident_id     BIGINT       NOT NULL,&#xA;    offense_code    VARCHAR(3)   NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Bridge_IncidentOffense&#xA;        PRIMARY KEY (incident_id, offense_code),&#xA;&#xA;    CONSTRAINT FK_BIO_Incident&#xA;        FOREIGN KEY (incident_id)&#xA;        REFERENCES dbo.Fact_JuvenileIncident(incident_id),&#xA;&#xA;    CONSTRAINT FK_BIO_Offense&#xA;        FOREIGN KEY (offense_code)&#xA;        REFERENCES dbo.Dim_Offense(offense_code)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.Bridge_IncidentArrestee&#xA;(&#xA;    incident_id     BIGINT   NOT NULL,&#xA;    arrestee_id     BIGINT   NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Bridge_IncidentArrestee&#xA;        PRIMARY KEY (incident_id, arrestee_id),&#xA;&#xA;    CONSTRAINT FK_BIA_Incident&#xA;        FOREIGN KEY (incident_id)&#xA;        REFERENCES dbo.Fact_JuvenileIncident(incident_id),&#xA;&#xA;    CONSTRAINT FK_BIA_Arrestee&#xA;        FOREIGN KEY (arrestee_id)&#xA;        REFERENCES dbo.Dim_Arrestee(arrestee_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.Bridge_IncidentOffender&#xA;(&#xA;    incident_id     BIGINT   NOT NULL,&#xA;    offender_id     BIGINT   NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Bridge_IncidentOffender&#xA;        PRIMARY KEY (incident_id, offender_id),&#xA;&#xA;    CONSTRAINT FK_BIOff_Incident&#xA;        FOREIGN KEY (incident_id)&#xA;        REFERENCES dbo.Fact_JuvenileIncident(incident_id),&#xA;&#xA;    CONSTRAINT FK_BIOff_Offender&#xA;        FOREIGN KEY (offender_id)&#xA;        REFERENCES dbo.Dim_Offender(offender_id)&#xA;);&#xA;&#xA;&#xA;CREATE TABLE dbo.Bridge_IncidentVictim&#xA;(&#xA;    incident_id     BIGINT   NOT NULL,&#xA;    victim_id       BIGINT   NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Bridge_IncidentVictim&#xA;        PRIMARY KEY (incident_id, victim_id),&#xA;&#xA;    CONSTRAINT FK_BIV_Incident&#xA;        FOREIGN KEY (incident_id)&#xA;        REFERENCES dbo.Fact_JuvenileIncident(incident_id),&#xA;&#xA;    CONSTRAINT FK_BIV_Victim&#xA;        FOREIGN KEY (victim_id)&#xA;        REFERENCES dbo.Dim_Victim(victim_id)&#xA;);&#xA;&#xA;&#xA;/*&#xA;    Tạo Incident → Weapon trực tiếp.&#xA;    Cách này đơn giản hơn rất nhiều khi sang SSAS many-to-many.&#xA;*/&#xA;CREATE TABLE dbo.Bridge_IncidentWeapon&#xA;(&#xA;    incident_id     BIGINT        NOT NULL,&#xA;    weapon_name     VARCHAR(60)   NOT NULL,&#xA;&#xA;    CONSTRAINT PK_Bridge_IncidentWeapon&#xA;        PRIMARY KEY (incident_id, weapon_name),&#xA;&#xA;    CONSTRAINT FK_BIW_Incident&#xA;        FOREIGN KEY (incident_id)&#xA;        REFERENCES dbo.Fact_JuvenileIncident(incident_id),&#xA;&#xA;    CONSTRAINT FK_BIW_Weapon&#xA;        FOREIGN KEY (weapon_name)&#xA;        REFERENCES dbo.Dim_Weapon(weapon_name)&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
